// # ooda-dashboard Connect & Interactive Command Runners
//
// Logline: Drives ooda-dashboard connect [status|register|probe] and interact [list|<verb> [target]].
// Setup: Enforces negative-trust CLI flag checks, host/port bounds, and allowlisted interact verbs cleanly.
// Beats:
//   1. Expose shared operand and bounded integer option parsers for cli subcommands.
//   2. Execute ooda-connect catalog status, services.oot registration, and TcpCap port probes.
//   3. Execute zero-shell allowlisted system queries and control transitions with --json output.

import "cli/version.oo";
import "cli/guard.oo";
import "core/store/anchor.oo";
import "core/connect/anchor.oo";
import "core/interact/anchor.oo";
import "ooda-standard/core/primitives/strconv.oo";

pub fn dash_operands(args: List[String], valued_csv: String) -> List[String] {
    let mut out: List[String] = list_new();
    let mut i: Int = 0;
    let mut dd: Bool = false;
    while i < list_len(args) {
        let a: String = list_get(args, i);
        if !dd && a == "--" {
            dd = true;
            i = i + 1;
            continue;
        }
        if !dd && str_starts_with(a, "-") {
            if valued_csv != "" && str_contains("," + valued_csv + ",", "," + a + ",") {
                i = i + 2;
            } else {
                i = i + 1;
            }
            continue;
        }
        out = list_push(out, a);
        i = i + 1;
    }
    return out;
}

pub fn dash_opt_int(args: List[String], flag: String, def_v: Int, lo: Int, hi: Int) -> Result[Int, String] {
    let v: String = dash_flag_val(args, flag);
    if v == "" { return Ok(def_v); }
    let pr: Result[Int, String] = parse_int(v);
    if pr.is_err() || pr.val < lo || pr.val > hi { return Err("invalid " + flag); }
    return Ok(pr.val);
}

fn dash_conn_status(fs: &FsReadCap, env: &EnvCap, ch: String, as_json: Bool) -> Int {
    let st: DashConnectState = oodash_connect_load(fs, env, ch);
    if as_json {
        println(oodash_connect_services_json(st));
        return 0;
    }
    println("ooda-dashboard " + oodash_version() + " connect home=" + st.home +
        " services=" + list_len(st.services).to_string() +
        " id_key=" + (if st.has_identity_key { "true" } else { "false" }) +
        " auth_keys=" + (if st.has_authorized_keys { "true" } else { "false" }));
    let mut i: Int = 0;
    while i < list_len(st.services) {
        let sv: DashConnectSvc = list_get(st.services, i);
        println("  " + sv.name + " kind=" + sv.kind + " target=" + sv.target + " caps=" + sv.caps_csv);
        i = i + 1;
    }
    return 0;
}

fn dash_conn_reg(
    fs: &FsReadCap, fw: &FsWriteCap, env: &EnvCap, norm: List[String], ch: String
) -> Int {
    let pr: Result[Int, String] = dash_opt_int(norm, "--port", 8440, 1, 65535);
    if pr.is_err() {
        println("ooda-dashboard connect: invalid --port");
        return 2;
    }
    let h0: String = dash_flag_val(norm, "--host");
    let host: String = if h0 == "" { "127.0.0.1" } else { h0 };
    let rr: Result[String, String] = oodash_connect_register(fs, fw, env, ch, host, pr.val);
    if rr.is_err() {
        println(rr.err);
        return 2;
    }
    if dash_has_flag(norm, "--json") {
        println("{\"component\":\"ooda-dashboard\",\"registered\":true,\"path\":\"" +
            rr.val + "\",\"target\":\"" + host + ":" + pr.val.to_string() + "\"}");
        return 0;
    }
    println("registered ooda-dashboard -> " + host + ":" + pr.val.to_string() + " (" + rr.val + ")");
    return 0;
}

pub fn oodash_connect_cmd(
    fs: &FsReadCap, fw: &FsWriteCap, tcp: &TcpCap, env: &EnvCap, args: List[String]
) -> Int {
    let norm: List[String] = dash_split_eq_args(args);
    let allow: String = "-h,--help,-v,-V,--version,--json";
    let valued: String = "--host,--port,--connect-home";
    let gerr: String = dash_guard_flags(norm, allow, valued);
    if gerr != "" {
        println("ooda-dashboard connect: " + gerr);
        return 2;
    }
    if dash_has_flag(norm, "-h") || dash_has_flag(norm, "--help") {
        println("usage: ooda-dashboard connect [status|register|probe] [--host H] [--port N] [--connect-home D] [--json]");
        return 0;
    }
    if dash_has_flag(norm, "-v") || dash_has_flag(norm, "-V") || dash_has_flag(norm, "--version") {
        println("ooda-dashboard " + oodash_version());
        return 0;
    }
    let ops: List[String] = dash_operands(norm, valued);
    if list_len(ops) > 1 {
        println("ooda-dashboard connect: unexpected extra operand");
        return 2;
    }
    let sub: String = if list_len(ops) == 1 { list_get(ops, 0) } else { "status" };
    let ch: String = dash_flag_val(norm, "--connect-home");
    if sub == "status" { return dash_conn_status(fs, env, ch, dash_has_flag(norm, "--json")); }
    if sub == "register" { return dash_conn_reg(fs, fw, env, norm, ch); }
    if sub == "probe" {
        println(oodash_connect_probe_all(tcp, oodash_connect_load(fs, env, ch)));
        return 0;
    }
    println("ooda-dashboard connect: unknown verb '" + sub + "'");
    return 2;
}

pub fn oodash_interact_cmd(fs: &FsReadCap, env: &EnvCap, args: List[String]) -> Int {
    let norm: List[String] = dash_split_eq_args(args);
    let allow: String = "-h,--help,-v,-V,--version,--json";
    let valued: String = "--health-file,--panel-file,--connect-home";
    let gerr: String = dash_guard_flags(norm, allow, valued);
    if gerr != "" {
        println("ooda-dashboard interact: " + gerr);
        return 2;
    }
    if dash_has_flag(norm, "-h") || dash_has_flag(norm, "--help") {
        println("usage: ooda-dashboard interact [list|<verb> [target]] [--connect-home D] [--json]");
        println(oodash_interact_help());
        return 0;
    }
    if dash_has_flag(norm, "-v") || dash_has_flag(norm, "-V") || dash_has_flag(norm, "--version") {
        println("ooda-dashboard " + oodash_version());
        return 0;
    }
    let ops: List[String] = dash_operands(norm, valued);
    if list_len(ops) > 2 {
        println("ooda-dashboard interact: too many operands");
        return 2;
    }
    let verb: String = if list_len(ops) >= 1 { list_get(ops, 0) } else { "overview" };
    if verb == "list" {
        println(oodash_interact_help());
        return 0;
    }
    let tgt: String = if list_len(ops) == 2 { list_get(ops, 1) } else { "" };
    let ch: String = dash_flag_val(norm, "--connect-home");
    let conn: DashConnectState = oodash_connect_load(fs, env, ch);
    let mut s0: RxDashboardStore = oodash_sample_host(fs, oodash_store_new(15));
    s0.connect_home = conn.home;
    s0.connect_services = list_len(conn.services);
    s0.connect_mesh_ready = conn.has_identity_key && conn.has_authorized_keys;
    let s1: RxDashboardStore = oodash_load_state_files(
        fs, s0, dash_flag_val(norm, "--health-file"), dash_flag_val(norm, "--panel-file")
    );
    let ir: Result[DashInteractOut, String] = oodash_interact_run(s1, conn, verb, tgt);
    if ir.is_err() {
        println("ooda-dashboard interact: " + ir.err);
        return 2;
    }
    if dash_has_flag(norm, "--json") {
        println(oodash_interact_json(ir.val));
    } else {
        println("ooda-dashboard interact ok kind=" + ir.val.kind + " verb=" + ir.val.verb);
        println(oodash_interact_json(ir.val));
    }
    return 0;
}
